{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "gehrisandro/tailwind-merge-laravel": "^1.4",
        "graham-campbell/github": "^13.1",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^3.8",
        "meilisearch/meilisearch-php": "^1.6",
        "spatie/commonmark-wire-navigate": "^1.0",
        "spatie/laravel-feed": "^4.5",
        "spatie/laravel-ignition": "^2.12",
        "spatie/laravel-markdown": "^2.5",
        "spatie/laravel-site-search": "^2.0.0",
        "spatie/sheets": "^1.11",
        "spatie/spatie-content-api": "^3.0.0",
        "spatie/spatie-price-api": "^1.0",
        "spatie/yaml-front-matter": "^2.0",
        "symfony/http-client": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0",
        "tempest/highlight": "^1.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.6",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.0",
        "spatie/laravel-ray": "^1.32"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": [
                "PKSA-j9hz-k29x-6s58",
                "PKSA-kq82-8x3t-s3fs",
                "PKSA-8m7x-943y-brpz",
                "PKSA-318x-z311-x7rh",
                "PKSA-y3ty-b1bg-gxtm",
                "PKSA-5jt2-w99c-cs4s"
            ]
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    }
}
